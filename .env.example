NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp Cloud API (warnings) — copy to .env.local; never commit secrets
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Optional: default is hello_world + en_US (no body vars). When your Arabic template is Active:
# WHATSAPP_TEMPLATE_NAME=warning_notification
# WHATSAPP_TEMPLATE_LANGUAGE=ar

# Paper expiry cron (manager warnings). Set in Vercel; request uses Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Web Push (portal PWA). Generate: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.com

# Synthetic login emails for employee signup approval (no applicant email). Must be a domain Auth accepts; override if createUser fails.
# SIGNUP_INTERNAL_AUTH_EMAIL_DOMAIN=your-project.supabase.co
